DB_URL=jdbc:postgresql://your-rds-endpoint:5432/skala_shop?sslmode=require
DB_USERNAME=skala_app
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=skala-shop-api
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=14d
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
INITIAL_MEMBER_POINTS=1000000
API_LOGGING_ENABLED=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_STORE=redis
AUTH_RATE_LIMIT_MAX_TRACKED_KEYS=50000
AUTH_LOGIN_IP_LIMIT=100
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_LOGIN_RATE_WINDOW=1m
AUTH_REGISTRATION_IP_LIMIT=30
AUTH_REGISTRATION_ACCOUNT_LIMIT=5
AUTH_REGISTRATION_RATE_WINDOW=10m
AUTH_PASSWORD_RESET_IP_LIMIT=20
AUTH_PASSWORD_RESET_ACCOUNT_LIMIT=5
AUTH_PASSWORD_RESET_RATE_WINDOW=10m
REDIS_HOST=redis
REDIS_PORT=6379
OUTBOX_RELAY_ENABLED=true
OUTBOX_PUBLISHER=kafka
OUTBOX_KAFKA_TOPIC=skala-shop.domain-events
KAFKA_BOOTSTRAP_SERVERS=172.31.36.153:9092
SEARCH_ENABLED=true
SEARCH_SERVICE_URL=http://172.31.32.50:8081
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_LOGIN_ID=
BOOTSTRAP_ADMIN_PASSWORD=
