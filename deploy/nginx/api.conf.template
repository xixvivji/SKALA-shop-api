map $request_method $auth_limit_key {
    OPTIONS "";
    default $binary_remote_addr;
}

map $http_origin $cors_allowed_origin {
    default "";
    "${FRONTEND_ORIGIN}" "${FRONTEND_ORIGIN}";
}

map $http_origin $cors_allow_credentials {
    default "";
    "${FRONTEND_ORIGIN}" "true";
}

map $http_origin $cors_expose_headers {
    default "";
    "${FRONTEND_ORIGIN}" "Retry-After, X-Correlation-ID";
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

log_format structured escape=json '{'
    '"timestamp":"$time_iso8601",'
    '"correlationId":"$request_id",'
    '"remoteAddress":"$remote_addr",'
    '"method":"$request_method",'
    '"path":"$uri",'
    '"status":$status,'
    '"requestTime":$request_time,'
    '"upstreamTime":"$upstream_response_time"'
    '}';

limit_req_zone $auth_limit_key zone=auth_per_ip:10m rate=10r/m;
limit_req_status 429;
limit_req_log_level warn;

server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};
    access_log /var/log/nginx/access.log structured;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};
    access_log /var/log/nginx/access.log structured;

    ssl_certificate /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    client_max_body_size 10m;

    # 기존 운영 health URL만 관리 포트로 전달합니다. Prometheus endpoint를 포함한
    # 다른 Actuator 경로는 이 edge에서 공개하지 않습니다.
    location = /actuator/health {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $management backend:9090;

        proxy_pass http://$management/actuator/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Correlation-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }

    location ^~ /actuator/ {
        return 404;
    }

    location = /grafana {
        return 301 /grafana/;
    }

    location /grafana/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $grafana grafana:3000;

        proxy_pass http://$grafana;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location ~ ^/api/customers(?:$|/login$|/password/reset$) {
        limit_req zone=auth_per_ip burst=5 nodelay;

        resolver 127.0.0.11 valid=30s ipv6=off;
        set $backend backend:8080;

        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Correlation-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    error_page 429 = @rate_limited;
    location @rate_limited {
        default_type application/json;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Access-Control-Allow-Origin $cors_allowed_origin always;
        add_header Access-Control-Allow-Credentials $cors_allow_credentials always;
        add_header Access-Control-Expose-Headers $cors_expose_headers always;
        add_header Vary Origin always;
        add_header Retry-After 60 always;
        return 429 '{"code":"TOO_MANY_REQUESTS","message":"요청이 너무 많습니다. 잠시 후 다시 시도해 주세요."}';
    }

    location / {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $backend backend:8080;

        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Correlation-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
