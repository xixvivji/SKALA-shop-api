DB_URL=jdbc:postgresql://localhost:5432/skala_shop
DB_USERNAME=skala
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=skala-shop-api
JWT_ACCESS_TOKEN_TTL=1h
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
INITIAL_MEMBER_POINTS=1000000
API_LOGGING_ENABLED=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_TRACKED_KEYS=50000
AUTH_LOGIN_IP_LIMIT=100
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_LOGIN_RATE_WINDOW=1m
AUTH_REGISTRATION_IP_LIMIT=30
AUTH_REGISTRATION_ACCOUNT_LIMIT=5
AUTH_REGISTRATION_RATE_WINDOW=10m
AUTH_PASSWORD_RESET_IP_LIMIT=20
AUTH_PASSWORD_RESET_ACCOUNT_LIMIT=5
AUTH_PASSWORD_RESET_RATE_WINDOW=10m
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_LOGIN_ID=
BOOTSTRAP_ADMIN_PASSWORD=
