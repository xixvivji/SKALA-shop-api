# compose.demo.yml은 환경 파일 없이도 localhost 전용 기본값으로 실행됩니다.
BACKEND_IMAGE=xixii/skala-shop-api:demo
DEMO_API_PORT=8080
DEMO_DB_NAME=skala_shop
DEMO_DB_USERNAME=skala_demo

# 다른 사람과 공유하는 PC나 네트워크 환경에서는 아래 값을 반드시 직접 지정하세요.
# 실제 운영 비밀값을 재사용하지 마세요.
# DB 초기화 뒤 계정 정보를 바꾸었다면 `docker compose -f compose.demo.yml down -v`로
# 시연 데이터를 지운 후 다시 시작해야 PostgreSQL에도 새 값이 적용됩니다.
# DEMO_DB_PASSWORD=replace-with-a-random-demo-only-password
# DEMO_JWT_SECRET=replace-with-a-random-demo-only-secret-at-least-32-bytes

DEMO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# 관리자 자동 생성은 기본적으로 꺼져 있습니다. 일회성 시연에서만 세 값을 함께 설정하세요.
# DEMO_BOOTSTRAP_ADMIN_ENABLED=true
# DEMO_BOOTSTRAP_ADMIN_LOGIN_ID=demo-admin
# DEMO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-12-to-72-byte-demo-password
